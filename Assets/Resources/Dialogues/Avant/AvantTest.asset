    y: -320
    width: 190
    height: 135
  IsDragging: 1
  IsSelected: 0
  _sentence:
    CharacterName: Avant
    Text: Careful, Nikolaus. Doubt breeds like rot. My loyalty was forged in the
      seas, not in court whispers.
    CharacterSprite: {fileID: -4583758162744181447, guid: 308da7f8ff69dc04190585d5e3c6e8da, type: 3}
  ParentNodes:
  - {fileID: -2556465912128616888}
