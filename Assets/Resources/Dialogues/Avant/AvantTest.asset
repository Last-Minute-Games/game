    serializedVersion: 2
    x: 361
    y: 458
    width: 190
    height: 135
  IsDragging: 1
  IsSelected: 0
  _sentence:
    CharacterName: Avant
    Text: If you think loyalty can be feigned, test me. I've bled for that crown
      more than any courtier here.
    CharacterSprite: {fileID: -4583758162744181447, guid: 308da7f8ff69dc04190585d5e3c6e8da, type: 3}
  ParentNodes:
