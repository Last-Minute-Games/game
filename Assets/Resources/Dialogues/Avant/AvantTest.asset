    x: -1660.833
    y: 75.66675
    width: 190
    height: 135
  IsDragging: 1
  IsSelected: 0
  _sentence:
    CharacterName: Avant
    Text: Hello Nikolaus, how was your day? You look like a burdened man.
    CharacterSprite: {fileID: -4583758162744181447, guid: 308da7f8ff69dc04190585d5e3c6e8da, type: 3}
  ParentNodes: []
  ChildNode: {fileID: 9197129819389211062}
