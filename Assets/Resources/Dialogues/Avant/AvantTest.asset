  NodeGraph: {fileID: 11400000}
  Rect:
    serializedVersion: 2
    x: 5396.671
    y: 729.1671
    width: 190
    height: 135
  IsDragging: 1
  IsSelected: 0
  _sentence:
    CharacterName: Nikolaus
    Text: "So the King did have a child, or at least someone he was planning on declaring
      next in line for the throne. Charles knew he was planning to do it and so did
      Avant. Before he could\u2026 someone killed him in a way that seems brash."
    CharacterSprite: {fileID: -5828640485074749218, guid: b0953f4b6178cc94fa70502eaa914060, type: 3}
  ParentNodes:
  - {fileID: 5173437448618743654}
  ChildNode: {fileID: 1616043764763156438}
