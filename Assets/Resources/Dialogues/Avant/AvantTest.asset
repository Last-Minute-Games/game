    height: 135
  IsDragging: 1
  IsSelected: 0
  _sentence:
    CharacterName: Avant
    Text: Guilt? Perhaps. But some killers take pride in their art. Watch the confident
      ones. Their calm is often rehearsed.
    CharacterSprite: {fileID: -4583758162744181447, guid: 308da7f8ff69dc04190585d5e3c6e8da, type: 3}
