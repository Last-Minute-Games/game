--- !u!114 &5128280778142857131
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a32a464d8ccff4e40a60c45b40a1e648, type: 3}
  m_Name: Sentence Node
  m_EditorClassIdentifier: Assembly-CSharp-firstpass::cherrydev.SentenceNode
  NodeGraph: {fileID: 11400000}
  Rect:
    serializedVersion: 2
    x: 5155.704
    y: 539.6997
    width: 170
    height: 260
  IsDragging: 1
  IsSelected: 0
  _sentence:
    CharacterName: Avant
    Text: "The King\u2026 He had an illegitimate child. That he was planning on recognizing
      as his heir. He knew he was old and unfit to rule and figured it was best to
      come out and declare it while he was still alive so his word would hold more
      weight."
