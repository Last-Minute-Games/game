--- !u!114 &6009734573094534318
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a32a464d8ccff4e40a60c45b40a1e648, type: 3}
  m_Name: Sentence Node
  m_EditorClassIdentifier: Assembly-CSharp-firstpass::cherrydev.SentenceNode
  NodeGraph: {fileID: 11400000}
  Rect:
    serializedVersion: 2
    x: 250.5
    y: 124.5
    width: 190
    height: 135
  IsDragging: 1
  IsSelected: 0
  _sentence:
    CharacterName: Avant
    Text: 'When I was a sailor in Norway, they made us fight to amuse the naval admiral.
      I''ve seen men kill, then smile. It taught me something: the calm ones are
      the most dangerous.'
    CharacterSprite: {fileID: -4583758162744181447, guid: 308da7f8ff69dc04190585d5e3c6e8da, type: 3}
  ParentNodes:
  - {fileID: -7079409306374727649}
  ChildNode: {fileID: -548675456962137107}
  _isExternalFunc: 0
  _externalFunctionName: 
  CharacterNameKey: 
  SentenceTextKey: 
