    width: 190
    height: 135
  IsDragging: 1
  IsSelected: 0
  _sentence:
    CharacterName: Avant
    Text: If I were you, I would start by questioning your fellow castle inhabitants.
      Surely someone knows more than they are letting on.
    CharacterSprite: {fileID: -4583758162744181447, guid: 308da7f8ff69dc04190585d5e3c6e8da, type: 3}
