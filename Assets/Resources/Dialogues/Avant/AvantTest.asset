    x: 268
    y: 640.5
    width: 190
    height: 135
  IsDragging: 0
  IsSelected: 0
  _sentence:
    CharacterName: Nikolaus
    Text: Still you were very close to the king.
    CharacterSprite: {fileID: -5828640485074749218, guid: b0953f4b6178cc94fa70502eaa914060, type: 3}
  ParentNodes:
  - {fileID: -1211290618911506022}
