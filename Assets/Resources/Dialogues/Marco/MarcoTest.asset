    height: 135
  IsDragging: 1
  IsSelected: 0
  _sentence:
    CharacterName: Marco
    Text: The castle is a bit suffocating at the moment. The guards are stationed
      around the surrounding area and are not letting anyone in or out. At least
      out here I can take in the scenery.
    CharacterSprite: {fileID: 1919691424312299089, guid: 3dc94aacbc1d6b94db175170fd85926c, type: 3}
