    height: 135
  IsDragging: 1
  IsSelected: 0
  _sentence:
    CharacterName: Marco
    Text: "No need to apologize. I understand it must feel like there is nobody you
      can trust right now. I will say though Nikolaus, you can trust me. Adrianne
      too. There is only\u2026"
    CharacterSprite: {fileID: 1919691424312299089, guid: 3dc94aacbc1d6b94db175170fd85926c, type: 3}
  ParentNodes:
