    serializedVersion: 2
    x: 1080.6666
    y: 16.000122
    width: 190
    height: 135
  IsDragging: 1
  IsSelected: 0
  _sentence:
    CharacterName: Sebastian
    Text: 'Well how do you think NIkolaus? Grover is dead and if the Kingdom had
      been holding on by a thread, it is now bond to collapse at any moment. '
    CharacterSprite: {fileID: -6322953688314822395, guid: c9583b64e73bdd1478a84d540701a034, type: 3}
