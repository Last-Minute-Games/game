    serializedVersion: 2
    x: 4194.1646
    y: 9.000153
    width: 190
    height: 135
  IsDragging: 1
  IsSelected: 0
  _sentence:
    CharacterName: Sebastian
    Text: Because you are nothing but a pleb playing at something he is not. I do
      not know why Grover even brought you into the castle, and I do not trust you.
    CharacterSprite: {fileID: -6322953688314822395, guid: c9583b64e73bdd1478a84d540701a034, type: 3}
  ParentNodes:
  - {fileID: 7775901377258256470}
