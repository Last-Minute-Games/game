    width: 190
    height: 135
  IsDragging: 1
  IsSelected: 0
  _sentence:
    CharacterName: Sebastian
    Text: I cannot. If I had someone in mind I would not share with you either.
    CharacterSprite: {fileID: -6322953688314822395, guid: c9583b64e73bdd1478a84d540701a034, type: 3}
