    y: 649
    width: 190
    height: 135
  IsDragging: 1
  IsSelected: 0
  _sentence:
    CharacterName: Nikolaus
    Text: (I beat Sebastian, hopefully now he will be willing to speak to me about
      the King's murder. At the very least I want to know where he was to see if
      I should suspect him.)
    CharacterSprite: {fileID: -5828640485074749218, guid: b0953f4b6178cc94fa70502eaa914060, type: 3}
  ParentNodes: []
  ChildNode: {fileID: -1584494736714723176}
