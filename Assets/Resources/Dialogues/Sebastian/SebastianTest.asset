  m_Name: Sentence Node
  m_EditorClassIdentifier: Assembly-CSharp-firstpass::cherrydev.SentenceNode
  NodeGraph: {fileID: 11400000}
  Rect:
    serializedVersion: 2
    x: 806.58325
    y: 682.75
    width: 190
    height: 135
  IsDragging: 1
  IsSelected: 0
  _sentence:
    CharacterName: Sebastian
    Text: You know what. I will tell you, provided you can entertain me a bit. I
      grow bored at my post. How about a coin flip game? If you beat me I will give
      you important information.
    CharacterSprite: {fileID: -6322953688314822395, guid: c9583b64e73bdd1478a84d540701a034, type: 3}
  ParentNodes:
  - {fileID: 1319802799837363103}
