    height: 135
  IsDragging: 1
  IsSelected: 0
  _sentence:
    CharacterName: Sebastian
    Text: I was asleep. Avant woke me up to mobilize the knights and troops. Since
      then I have stayed here in the armoy while keeping in contact with the other
      knights as to anything suspicious.
    CharacterSprite: {fileID: -6322953688314822395, guid: c9583b64e73bdd1478a84d540701a034, type: 3}
