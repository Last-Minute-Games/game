  m_Script: {fileID: 11500000, guid: a32a464d8ccff4e40a60c45b40a1e648, type: 3}
  m_Name: Sentence Node
  m_EditorClassIdentifier: Assembly-CSharp-firstpass::cherrydev.SentenceNode
  NodeGraph: {fileID: 11400000}
  Rect:
    serializedVersion: 2
    x: 1386
    y: 686
    width: 190
    height: 135
  IsDragging: 1
  IsSelected: 0
  _sentence:
    CharacterName: Sebastian
    Text: It is no secret that we are an easy target. No heir has been named. We
      were hoping the King had more years left in him and would eventually name someone
      he wanted to pass the throne down to. Now with him gone and no clear heir named,
      anyone will try to claim the throne or worst yet conquer us.
    CharacterSprite: {fileID: -6322953688314822395, guid: c9583b64e73bdd1478a84d540701a034, type: 3}
  ParentNodes:
  - {fileID: -7885906385303265709}
  ChildNode: {fileID: 3254787349553903804}
  _isExternalFunc: 0
  _externalFunctionName: 
  CharacterNameKey: 
  SentenceTextKey: 
