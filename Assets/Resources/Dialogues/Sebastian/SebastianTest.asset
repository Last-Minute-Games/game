    width: 190
    height: 135
  IsDragging: 1
  IsSelected: 0
  _sentence:
    CharacterName: Sebastian
    Text: Are you dense? The King was brutally murdered some time last night. We
      have reason to believe they are among us still. The lockdown is to hopefully
      prevent them from leaving the castle grounds.
    CharacterSprite: {fileID: -6322953688314822395, guid: c9583b64e73bdd1478a84d540701a034, type: 3}
  ParentNodes:
