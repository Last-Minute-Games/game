    x: 2680.9995
    y: 618.3333
    width: 190
    height: 135
  IsDragging: 1
  IsSelected: 0
  _sentence:
    CharacterName: Allistair
    Text: An emergency meeting with all the nobles from other Kingdomes will likely
      be held soon. From there we will decide what will happen.
    CharacterSprite: {fileID: -576682515621079745, guid: a8f3de5593ac3994dbfcc6ac3125b589, type: 3}
  ParentNodes:
  - {fileID: 6993239648183675222}
