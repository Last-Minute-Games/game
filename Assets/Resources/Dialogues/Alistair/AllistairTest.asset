    serializedVersion: 2
    x: 4125.498
    y: 524.6667
    width: 190
    height: 135
  IsDragging: 1
  IsSelected: 0
  _sentence:
    CharacterName: Allistair
    Text: "I just\u2026 I hate to cause tension. I did find that Charles was acting
      a little weird. He seemed oddly stoic about the whole situation."
    CharacterSprite: {fileID: -576682515621079745, guid: a8f3de5593ac3994dbfcc6ac3125b589, type: 3}
