    y: 481.6668
    width: 190
    height: 135
  IsDragging: 1
  IsSelected: 0
  _sentence:
    CharacterName: Allistair
    Text: Once word of his majesty's death gets out if no plan is in place we risk
      a civil war.
    CharacterSprite: {fileID: -576682515621079745, guid: a8f3de5593ac3994dbfcc6ac3125b589, type: 3}
  ParentNodes:
