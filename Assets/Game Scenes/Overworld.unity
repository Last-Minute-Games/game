  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Sebastian was raised by his mother since birth while his father served
    in the nation''s honor knight. Growing up, he was a joyful boy who had a passion
    to follow his father''s path and become the most honorable Knight. He excels
    at his school work at his young age, makes lots of friends, and his swordsmanship
    skills are sharper than ever. Got hired as a Knight''s apprentice at the age
    of nineteen, thought he would be happy, but the smile didn''t last long. Sebastian
    witnessed his father being hanged for being the nation''s betrayer by the King.
    His mother passed away from a heart attack after receiving the news of her husband''s
    death.



