--- !u!114 &818791382
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 818791379}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cfa27267e17605848a6147876ece68b4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NetherTutorial
  slides:
  - image: {fileID: 2999459662881226216, guid: 9c42f4c4191e049f79dce9d1dfa5e72e, type: 3}
    text: "You are <color=#FF4A4A>dead</color>.\n\nYou are in purgatory due to a
      <color=#C77DFF>curse</color>. \nYou must <color=#FFA53F>fight your way out</color>.\n\nIf
      you <color=#FF4A4A>lose</color>, you lose time on your clock.\nIf you <color=#6CFF6C>win</color>,
      you gain time on your clock."
    slideOrder: 0
  - image: {fileID: -697763020151794088, guid: 0bece81d2e79bd44c849e7bf23aa328f, type: 3}
    text: "You are placed into a turn-based card battle.\n\nOn the top left, you
      will find a <color=#5BCEFA>timer</color>. \nPay close attention\u2014when it
      runs out, your turn ends automatically."
    slideOrder: 1
  - image: {fileID: 4448715427215634006, guid: f8d7722b39808df4b874873ad6fb1a95, type: 3}
    text: "You will receive a <color=#FFA53F>deck of cards</color>.\n\nEach card
      has a number in the top-left corner representing its \n<color=#5BCEFA>energy
      cost</color>.\n\nYour current <color=#5BCEFA>energy</color> is shown in the
      bottom-left corner.\nIf it reaches <color=#FFA53F>0</color>, your turn ends
      instantly."
    slideOrder: 2
  - image: {fileID: 4448715427215634006, guid: f8d7722b39808df4b874873ad6fb1a95, type: 3}
    text: "The card description explains what the card does when played.\n\nSome
      cards apply <color=#5BCEFA>modifiers</color>\u2014these can be good or bad.\n\nPay
      attention to the titles and effects."
    slideOrder: 3
  - image: {fileID: 4448715427215634006, guid: f8d7722b39808df4b874873ad6fb1a95, type: 3}
    text: "Watch for <color=#FFA53F>intention</color> icons above \n<color=#FF4A4A>enemies</color>.
      \n\nThese reveal what the enemy will do once your turn ends."
    slideOrder: 4
  - image: {fileID: 4448715427215634006, guid: f8d7722b39808df4b874873ad6fb1a95, type: 3}
    text: 'Your <color=#FF2E2E>health bar</color> is at the top of the screen.


      If
      you have any <color=#5BCEFA>defense</color>, your health bar will glow.


      The
      same applies for <color=#FF4A4A>enemies</color>.'
    slideOrder: 5
  - image: {fileID: 4448715427215634006, guid: f8d7722b39808df4b874873ad6fb1a95, type: 3}
    text: Survive all enemy waves to escape the  <color=#C77DFF>curse's punishment</color>. 
      <color=#FF4A4A>It will get harder.</color>
    slideOrder: 5
  canvasGroup: {fileID: 818791381}
  slideImage: {fileID: 1622782426}
  slideText: {fileID: 367777132}
  slideCounter: {fileID: 1610738212}
  nextButton: {fileID: 2129146771}
  prevButton: {fileID: 897064182}
  startGameButton: {fileID: 1706062458}
  turnPageSFX: {fileID: 0}
